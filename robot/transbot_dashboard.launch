<launch>
  <!-- =====================================================================
       transbot_dashboard.launch — the COMPLETE robot-side stack for the
       dashboard. This replaces the factory app autostart (which held the
       camera exclusively and supervised its own duplicate of the stack).

       Starts:
         1. driver bringup (transbot_driver.py owns all hardware, plus
            DeviceSrv, IMU calib/filter, EKF, joint/robot state publishers)
         2. usb_cam        -> /usb_cam/image_raw from /dev/video0
         3. web_video_server -> MJPEG over HTTP :8080
         4. rosbridge      -> WebSocket :9090

       Run by rosbridge-dashboard.service at boot (headless, no GUI needed).
       The factory autostart entry is parked in ~/factory_autostart_disabled/
       — restore it by moving bash.desktop back to ~/.config/autostart/ and
       disabling this service.
       ===================================================================== -->

  <!-- 1. Yahboom driver bringup -->
  <include file="$(find transbot_bringup)/launch/bringup.launch" />

  <!-- 2. Camera: 720p requires MJPG capture (the sensor only does 9 fps of
       raw YUYV at 1280x720, but 60 fps of MJPG; we cap at 30 to keep the
       Nano's decode + re-encode load sane). -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen"
        respawn="true" respawn_delay="5">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="1280" />
    <param name="image_height" value="720" />
    <param name="pixel_format" value="mjpeg" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="usb_cam" />
  </node>

  <!-- 3. MJPEG video server -->
  <node name="web_video_server" pkg="web_video_server" type="web_video_server"
        output="screen">
    <param name="port" value="8080" />
  </node>

  <!-- 4. rosbridge WebSocket server -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="9090" />
  </include>

  <!-- 5. SAFETY: cmd_vel watchdog. The driver executes the last command
       forever; if the teleop link degrades mid-drive (silent TCP blackhole,
       not a clean close) no zero-Twist ever arrives and the robot runs
       away — observed in the field. This node publishes zero Twists after
       0.5 s of command silence while moving. The script is deployed into
       transbot_bringup/scripts/ so roslaunch can resolve it. -->
  <node name="cmd_vel_watchdog" pkg="transbot_bringup" type="cmd_vel_watchdog.py"
        output="screen" respawn="true" respawn_delay="5" />

  <!-- 6. SAFETY: command-priority mux. Sole publisher to /cmd_vel: forwards
       /manual/cmd_vel (dashboard) always, /ai/cmd_vel only while /ai/enabled
       and manual is quiet, clamped to the AI speed caps. Deployed into
       transbot_bringup/scripts/ like the watchdog. -->
  <node name="cmd_vel_mux" pkg="transbot_bringup" type="cmd_vel_mux.py"
        output="screen" respawn="true" respawn_delay="5" />
</launch>
